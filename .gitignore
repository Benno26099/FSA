# ---------------------------------------------------------------------------
# Upstream FSA .gitignore (unchanged)
# ---------------------------------------------------------------------------
target
.metals
.scala-build
.vscode
build
*.vcd
*.fst
*.log

# ---------------------------------------------------------------------------
# Thesis-only additions (fork-local)
# ---------------------------------------------------------------------------

# Personal thesis materials — investigation log, roadmap, test-fix reference.
# Kept out of the fork; maintained separately.
docs/thesis/

# Self-authored reference docs. Deliberately *.md rather than docs/ — the
# upstream images (fpga.jpg, innerloop.gif, microarch.jpg) are tracked and
# must stay that way.
docs/*.md

# Scratch test scripts, superseded by dispatcher.py / test_transpose_dma.py
python/test_transpose_attention.py
python/transpose_test.py

# Scala / SBT build state not already covered above
project/target/
project/project/
project/build.properties
.bloop/
.bsp/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.python-version

# IDE / editor
.idea/
*.iml
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Verilator waveforms / dumps not covered by *.vcd or *.fst
*.wlf
*.wave
transcript

# Local scratch / notes not intended for the fork.
# Uncomment if you keep scratch files at the repo root and don't want them tracked.
# scratch/
# TODO.md
# NOTES.md

# Thesis scripts and results are tracked (thesis/); keep their run logs too.
!thesis/results/**/*.log
